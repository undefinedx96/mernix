{
  "name": "server",
  "module": "./src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --watch ./src/server.ts",
    "start": "tsx ./src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "type-watch": "tsc --noEmit -w",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3000"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^2.1.1",
    "swagger-ui-express": "^5.0.1"
  }
